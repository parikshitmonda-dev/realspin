rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'parikshitmonda@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Global Rounds (publicly visible and synchronized for spin wheel game)
    match /rounds/{roundId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write, delete: if true;
    }

    // Coin requests
    match /coin_requests/{requestId} {
      allow read, write: if true;
    }

    // Bets
    match /bets/{betId} {
      allow read, write: if true;
    }

    // Ledger transactions
    match /ledger/{txId} {
      allow read, write: if true;
    }

    // Admin activity logs
    match /admin_logs/{logId} {
      allow read, write: if true;
    }

    // System settings
    match /system_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }
  }
}

